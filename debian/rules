#!/usr/bin/make -f

export PYBUILD_NAME = xping
# the upstream suite needs no network; it reads docs/ and man/ from the source tree
export PYBUILD_TEST_PYTEST = 1
export PYBUILD_TEST_ARGS = {dir}/tests -q -p no:cacheprovider
# tests must never read or write the builder's home
export HOME = $(CURDIR)/debian/.home

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_installman:
	dh_installman man/xping.1

# Shell completion for all three shells, generated from the CLI definition.
# (zsh: vendor-completions precedes zsh's own function dirs in fpath, so this
# _xping wins over the _hosts completion that also claims the name "xping".)
execute_after_dh_auto_install:
	mkdir -p debian/xping/usr/share/bash-completion/completions \
	         debian/xping/usr/share/zsh/vendor-completions \
	         debian/xping/usr/share/fish/vendor_completions.d
	PYTHONPATH=. python3 -m xping completion bash > debian/xping/usr/share/bash-completion/completions/xping
	PYTHONPATH=. python3 -m xping completion zsh  > debian/xping/usr/share/zsh/vendor-completions/_xping
	PYTHONPATH=. python3 -m xping completion fish > debian/xping/usr/share/fish/vendor_completions.d/xping.fish

execute_after_dh_clean:
	rm -rf debian/.home
