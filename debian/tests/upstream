#!/bin/sh
# Run the upstream test suite against the installed xping (not the source
# tree): copy only the tests and the files they read into a scratch dir.
set -eu
cp -r tests docs man scripts README.md pyproject.toml "$AUTOPKGTEST_TMP"
cd "$AUTOPKGTEST_TMP"
export HOME="$AUTOPKGTEST_TMP/home"
mkdir -p "$HOME"
for py in $(py3versions -s); do
    echo "=== $py"
    "$py" -m pytest -q -p no:cacheprovider tests
done
